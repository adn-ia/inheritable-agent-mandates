# ─── AGENT (son corps économique) ───────────────────────────────
# Génère-la avec:  npm run wallet:new    — TESTNET UNIQUEMENT.
PRIVATE_KEY=0x...

# RPC Base Sepolia
RPC_URL=https://sepolia.base.org

# ─── GARDIEN humain ─────────────────────────────────────────────
# Adresse PUBLIQUE du gardien. Génère la paire avec: npm run guardian:new
# L'agent ne doit connaître QUE cette adresse, jamais la clé privée.
GUARDIAN_ADDRESS=

# ─── ÉCONOMIE / INFRA (ETH testnet) ─────────────────────────────
TASK_PRICE_ETH=0.00002
COMPUTE_COST_ETH=0.000005
COMPUTE_PROVIDER=0x000000000000000000000000000000000000dEaD
DEATH_THRESHOLD_ETH=0.000001
METABOLISM_INTERVAL_S=30
PORT=8080

# NB : les CLAUSES DE CONTRÔLE héritables (plafond de dépense, allowlist de payées,
# bail obligatoire, télomère) ne sont PLUS des variables d'env — elles vivent dans le
# MANDAT du génome (src/genome.ts → genome.mandate), pour être inscrites dans l'identité
# et héritées par les enfants au spawn.

# ─── OUTIL GARDIEN (à garder SÉPARÉ de l'agent) ─────────────────
# Ne mets ceci QUE là où tu signes bail/kill/embargo/spawn, PAS avec l'agent.
GUARDIAN_PRIVATE_KEY=0x...
